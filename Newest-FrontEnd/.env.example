# Endereço da API (back-end). Local: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Nome da conta no Cloudinary (onde as imagens são enviadas)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Upload preset "unsigned" do Cloudinary (padrão: newest)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=newest
