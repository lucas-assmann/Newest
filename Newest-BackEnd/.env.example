# Banco PostgreSQL (Neon). Para desenvolver, use um banco separado do de produção.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo para assinar os tokens JWT (qualquer texto longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo"

# Cloudinary (onde ficam as imagens)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Sightengine (moderação de imagens). Sem isso, posts com imagem são recusados.
SIGHTENGINE_USER=""
SIGHTENGINE_SECRET=""
